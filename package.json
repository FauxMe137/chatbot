{
  "name": "chatbot",
  "version": "1.0.0",
  "description": "A website for chatting with an AI bot.",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "build:js": "esbuild public/script.js --minify --outfile=public/script.min.js",
    "build:css": "esbuild public/style.css --minify --outfile=public/style.min.css",
    "build": "npm run build:js && npm run build:css",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FauxMe137/chatbot.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FauxMe137/chatbot/issues"
  },
  "homepage": "https://github.com/FauxMe137/chatbot#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
